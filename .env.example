# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses Row Level Security — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe — Developers > API keys (use TEST keys, they start with sk_test_ / pk_test_)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
# From the webhook endpoint's signing secret (starts with whsec_).
# Locally: `stripe listen --forward-to localhost:3000/api/webhooks/stripe`
STRIPE_WEBHOOK_SECRET=

# Any random string. Authorises the daily keep-alive cron that stops the
# Supabase free-tier project from pausing after ~7 days idle.
CRON_SECRET=

# Optional. Absolute base URL used for sitemap.xml, robots.txt, and Open
# Graph tags. Falls back to the Vercel production URL when unset.
NEXT_PUBLIC_SITE_URL=
