# Dependencies
node_modules

# Next.js build output
.next
out

# Generated by Next.js / TypeScript on every build — regenerated
# automatically, and next-env.d.ts flip-flops between .next/types and
# .next/dev/types depending on whether dev or build ran last, which
# otherwise shows up as a meaningless diff on every machine.
next-env.d.ts
*.tsbuildinfo

# Environment files — real secrets live here and must never be committed.
# .env.example is the one exception: it's the template, with no values.
.env
.env.local
.env.*.local
.env*
!.env.example

# Vercel CLI link metadata (project/org IDs, not source)
.vercel

# OS junk
.DS_Store
Thumbs.db

# Debug logs
npm-debug.log*
